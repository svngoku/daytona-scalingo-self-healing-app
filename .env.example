# Fixture is an explicitly scripted AI substitute; HTTP, logs and Docker tests are real.
DEMO_MODE=true
AGENT_MODE=fixture
SANDBOX_PROVIDER=docker
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
SANDBOX_IMAGE=python:3.12-bookworm
SANDBOX_TIMEOUT_SECONDS=600
COMMAND_TIMEOUT_SECONDS=120
SCALINGO_API_TOKEN=
SCALINGO_APP_NAME=
SCALINGO_API_URL=https://api.osc-fr1.scalingo.com
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPOSITORY=
GITHUB_DEFAULT_BRANCH=main
# Comma-separated owner/repo list; mandatory for real repository operations.
GITHUB_ALLOWED_REPOSITORIES=
GITHUB_DRY_RUN=true
GITHUB_WRITE_ENABLED=false
# Required in live mode; set in dashboard Settings as well. Never a NEXT_PUBLIC variable.
ORCHESTRATOR_API_TOKEN=
DATABASE_URL=sqlite:///.data/incidents.db
BROKEN_APP_URL=http://127.0.0.1:8001
LOCAL_LOGS_PATH=.data/broken-app.jsonl
LOG_PATH=.data/broken-app.jsonl
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REVIEW_TIMEOUT_SECONDS=600
REVIEW_POLL_SECONDS=5
# Scalingo-generated *.scalingo.io URLs are allowed by default.
REVIEW_ALLOWED_HOSTS=
ORCHESTRATOR_API_URL=http://127.0.0.1:8000
